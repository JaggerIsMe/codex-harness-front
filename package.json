{
  "name": "my-harness-for-codex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.json"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.0.10",
    "pinia": "^3.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sass": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
