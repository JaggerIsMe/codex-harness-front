# Dependencies and package-manager caches (keep package lockfiles)
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Vite / TypeScript build output and caches
/dist/
/dist-ssr/
.vite/
.vite-temp/
.cache/
*.tsbuildinfo
vite.config.*.timestamp-*
.eslintcache
.stylelintcache

# Test output (keep tests, fixtures and committed snapshots)
/coverage/
.nyc_output/
/test-results/
/playwright-report/
/playwright/.cache/
/playwright/.auth/
/blob-report/

# Logs and local process state
/logs/
*.log
*.log.*
*.pid
*.pid.lock
*.seed
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files: only shared, non-secret modes and templates are versioned
.env
.env.*
!.env.development
!.env.production
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
.env.local
.env.*.local

# Editors (keep portable VS Code recommendations and shared settings)
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln

# OS metadata and temporary files
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
*.orig
/tmp/
/temp/
/.scratch/
